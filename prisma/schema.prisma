datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  LEARNER
  CONTRIBUTOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ContentOwnership {
  OWNED
  OPEN_LICENSE
  EXTERNAL_CURATED
}

enum ContentType {
  TEXT
  VIDEO_URL
  EXTERNAL_LINK
  DOCUMENT_URL
  CODE_REPO
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum ReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum AIMode {
  DISCOVERY
  TUTORING
  LEARNING_PATH
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum DocumentSourceType {
  LESSON_CONTENT
  UPLOADED_PDF
}

enum IndexingStatus {
  PENDING
  INDEXED
  FAILED
}

enum MemoryType {
  PREFERENCE
  LEARNING_CONTEXT
  GOAL
  SKILL
  DIFFICULTY
  STUDY_HABIT
  INTEREST
}

// ==========================================
// USER DOMAIN
// ==========================================

model User {
  id              String        @id @default(cuid())
  authUserId      String?       @unique
  email           String        @unique
  normalizedEmail String        @unique
  passwordHash    String?
  name            String
  role            Role          @default(LEARNER)
  status          AccountStatus @default(ACTIVE)
  bio             String?
  avatarUrl       String?
  memoryEnabled   Boolean       @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  courses         Course[]         @relation("AuthorCourses")
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  courseProgress  CourseProgress[]
  savedCourses    SavedCourse[]
  reviewsAuthored CourseReview[]   @relation("AdminReviews")
  auditLogs       AuditLog[]       @relation("ActorAuditLogs")
  contentReports  ContentReport[]  @relation("UserReports")
  resolvedReports ContentReport[]  @relation("AdminResolvedReports")
  aiConversations AIConversation[]
  uploadedFiles   FileAsset[]
  memories        UserMemory[]

  @@index([role, status])
  @@index([createdAt])
  @@index([authUserId])
}

// ==========================================
// CATALOG & TAXONOMIES
// ==========================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  courses     Course[]

  @@index([slug])
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  slug    String      @unique
  courses CourseTag[]

  @@index([slug])
}

model CourseTag {
  courseId String
  tagId    String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
}

// ==========================================
// COURSE STRUCTURE
// ==========================================

model Course {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  shortSummary     String
  description      String
  difficulty       Difficulty       @default(BEGINNER)
  language         String           @default("English")
  estimatedHours   Float?
  thumbnailUrl     String?
  status           CourseStatus     @default(DRAFT)
  license          String           @default("CC-BY-4.0")
  contentOwnership ContentOwnership @default(OPEN_LICENSE)
  authorId         String
  categoryId       String?
  rejectionReason  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  publishedAt      DateTime?

  author          User             @relation("AuthorCourses", fields: [authorId], references: [id], onDelete: Restrict)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            CourseTag[]
  modules         Module[]
  enrollments     Enrollment[]
  progress        CourseProgress[]
  savedBy         SavedCourse[]
  reviews         CourseReview[]
  contentReports  ContentReport[]
  aiConversations AIConversation[]
  documents       Document[]

  @@index([status, publishedAt])
  @@index([authorId, status])
  @@index([categoryId, status])
  @@index([difficulty])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([courseId, orderIndex])
  @@index([courseId, orderIndex])
}

model Lesson {
  id              String           @id @default(cuid())
  moduleId        String
  title           String
  slug            String
  description     String?
  contentType     ContentType      @default(TEXT)
  textContent     String?
  mediaUrl        String?
  durationMinutes Int?
  orderIndex      Int
  isRequired      Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources       Resource[]
  progress        LessonProgress[]
  contentReports  ContentReport[]
  aiConversations AIConversation[]
  documents       Document[]

  @@unique([moduleId, orderIndex])
  @@unique([moduleId, slug])
  @@index([moduleId, orderIndex])
}

model Resource {
  id             String          @id @default(cuid())
  lessonId       String
  title          String
  resourceType   String          @default("EXTERNAL_LINK")
  url            String
  description    String?
  isInternal     Boolean         @default(false)
  createdAt      DateTime        @default(now())

  lesson         Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  contentReports ContentReport[]

  @@index([lessonId])
}

// ==========================================
// LEARNING DOMAIN
// ==========================================

model Enrollment {
  id             String    @id @default(cuid())
  userId         String
  courseId       String
  enrolledAt     DateTime  @default(now())
  lastAccessedAt DateTime  @default(now())
  completedAt    DateTime?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, enrolledAt])
  @@index([courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
  @@index([lessonId])
}

model CourseProgress {
  id               String    @id @default(cuid())
  userId           String
  courseId         String
  completedLessons Int       @default(0)
  totalLessons     Int       @default(0)
  percentage       Float     @default(0.0)
  isCompleted      Boolean   @default(false)
  lastLessonId     String?
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, isCompleted])
  @@index([courseId])
}

model SavedCourse {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, createdAt])
}

// ==========================================
// GOVERNANCE & MODERATION
// ==========================================

model CourseReview {
  id         String       @id @default(cuid())
  courseId   String
  reviewerId String
  action     ReviewAction @default(SUBMITTED)
  comments   String?
  createdAt  DateTime     @default(now())

  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewer   User         @relation("AdminReviews", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([courseId, createdAt])
  @@index([reviewerId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model ContentReport {
  id              String       @id @default(cuid())
  reporterId      String
  courseId        String?
  lessonId        String?
  resourceId      String?
  reason          String
  description     String?
  status          ReportStatus @default(OPEN)
  reviewedById    String?
  reviewedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  reporter        User         @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer        User?        @relation("AdminResolvedReports", fields: [reviewedById], references: [id], onDelete: SetNull)
  course          Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson          Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  resource        Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId])
}

// ==========================================
// AI & NOVA DOMAIN
// ==========================================

model AIConversation {
  id        String      @id @default(cuid())
  userId    String?
  courseId  String?
  lessonId  String?
  mode      AIMode      @default(DISCOVERY)
  title     String      @default("Learning Session")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson            Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages          AIMessage[]
  memoriesExtracted UserMemory[]

  @@index([userId, createdAt])
  @@index([courseId])
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole @default(USER)
  content        String
  createdAt      DateTime      @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model UserMemory {
  id                   String          @id @default(cuid())
  userId               String
  memoryType           MemoryType
  key                  String
  value                String          @db.Text
  source               String          @default("CONVERSATION")
  sourceConversationId String?
  importance           Int             @default(1)
  confidence           Float           @default(1.0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lastUsedAt           DateTime?
  metadata             Json?

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConversation AIConversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)

  @@unique([userId, memoryType, key])
  @@index([userId, memoryType])
  @@index([userId, updatedAt])
}

// ==========================================
// MEDIA & FILE STORAGE
// ==========================================

model FileAsset {
  id              String   @id @default(cuid())
  uploaderId      String?
  storageProvider String   @default("supabase")
  bucket          String   @default("course-assets")
  objectPath      String   @unique
  fileName        String
  mimeType        String
  sizeBytes       Int
  isPublic        Boolean  @default(true)
  createdAt       DateTime @default(now())

  uploader        User?       @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  documents       Document[]

  @@index([uploaderId])
  @@index([bucket])
}

// ==========================================
// RAG & KNOWLEDGE BASE
// ==========================================

model Document {
  id           String             @id @default(cuid())
  courseId     String
  lessonId     String?
  fileAssetId  String?
  sourceType   DocumentSourceType @default(LESSON_CONTENT)
  contentHash  String?
  status       IndexingStatus     @default(PENDING)
  errorMessage String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fileAsset FileAsset?      @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]

  @@index([courseId, status])
  @@index([lessonId])
  @@index([fileAssetId])
  @@index([contentHash])
}

model DocumentChunk {
  id               String                      @id @default(cuid())
  documentId       String
  chunkIndex       Int
  content          String                      @db.Text
  tokenCount       Int
  embedding        Unsupported("vector(768)")?
  tsvContent       Unsupported("tsvector")?
  embeddingModel   String                      @default("gemini-embedding-2")
  embeddingVersion String                      @default("1")
  metadata         Json?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}
