datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  LEARNER
  CONTRIBUTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum ContentType {
  TEXT
  VIDEO_URL
  EXTERNAL_LINK
  DOCUMENT_URL
  CODE_REPO
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  name          String
  role          String          @default("LEARNER") // Stored as string for SQLite compatibility: LEARNER, CONTRIBUTOR, ADMIN
  bio           String?
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  courses       Course[]        @relation("AuthorCourses")
  enrollments   Enrollment[]
  lessonProgress LessonProgress[]
  courseProgress CourseProgress[]
  reviews       CourseReview[]  @relation("AdminReviews")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  courses     Course[]
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  slug    String      @unique
  courses CourseTag[]
}

model CourseTag {
  courseId String
  tagId    String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
}

model Course {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  shortSummary    String
  description     String
  difficulty      String          @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED, ALL_LEVELS
  language        String          @default("English")
  estimatedHours  Float?
  thumbnailUrl    String?
  status          String          @default("DRAFT") // DRAFT, PENDING_REVIEW, PUBLISHED, REJECTED
  authorId        String
  categoryId      String?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  publishedAt     DateTime?

  author          User            @relation("AuthorCourses", fields: [authorId], references: [id])
  category        Category?       @relation(fields: [categoryId], references: [id])
  tags            CourseTag[]
  modules         Module[]
  enrollments     Enrollment[]
  progress        CourseProgress[]
  reviews         CourseReview[]

  @@index([status])
  @@index([authorId])
  @@index([categoryId])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId, orderIndex])
}

model Lesson {
  id              String           @id @default(cuid())
  moduleId        String
  title           String
  slug            String
  description     String?
  contentType     String           @default("TEXT") // TEXT, VIDEO_URL, EXTERNAL_LINK, DOCUMENT_URL, CODE_REPO
  textContent     String?          // Markdown or detailed explanation
  mediaUrl        String?          // Video or external URL
  durationMinutes Int?
  orderIndex      Int
  isRequired      Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources       Resource[]
  progress        LessonProgress[]

  @@index([moduleId, orderIndex])
}

model Resource {
  id           String   @id @default(cuid())
  lessonId     String
  title        String
  resourceType String   @default("EXTERNAL_LINK")
  url          String
  description  String?
  createdAt    DateTime @default(now())

  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model CourseProgress {
  id               String    @id @default(cuid())
  userId           String
  courseId         String
  completedLessons Int       @default(0)
  totalLessons     Int       @default(0)
  percentage       Float     @default(0.0)
  isCompleted      Boolean   @default(false)
  lastLessonId     String?
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, courseId])
}

model CourseReview {
  id         String   @id @default(cuid())
  courseId   String
  reviewerId String
  action     String   // PUBLISHED or REJECTED
  comments   String?
  createdAt  DateTime @default(now())

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("AdminReviews", fields: [reviewerId], references: [id])
}
