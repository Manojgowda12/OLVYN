# ============================================================
# OLVYN — Production Environment Variable Contract
# ============================================================
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env, .env.local, or .env.production to source control.
# Configure ALL variables below in your Render service environment settings.
# ============================================================

# ── DATABASE (Supabase PostgreSQL) ──────────────────────────
# Transaction Pooler — used by runtime Prisma Client (port 6543, pgbouncer=true)
# SERVER-ONLY. Never expose to browser.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / Session Connection — used ONLY by Prisma migrations (port 5432)
# SERVER-ONLY. Never expose to browser.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── AUTHENTICATION ───────────────────────────────────────────
# JWT session signing secret. MINIMUM 32 characters, high-entropy.
# Production: missing or short secret causes a hard startup failure (fails closed).
# SERVER-ONLY. Never expose to browser.
AUTH_SECRET="your-minimum-32-character-high-entropy-secret-here"

# ── GOOGLE GEMINI AI ─────────────────────────────────────────
# Powers Nova AI learning assistant and RAG document embeddings.
# SERVER-ONLY. Never expose to browser.
GEMINI_API_KEY="your-gemini-api-key"

# Embedding model identifier (optional — default: gemini-embedding-2)
# SERVER-ONLY.
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Vector dimension size for pgvector embeddings (optional — default: 768)
# SERVER-ONLY.
GEMINI_EMBEDDING_DIMENSIONS="768"

# ── SUPABASE (SERVER-SIDE) ───────────────────────────────────
# Privileged server-side key for storage administration and secure backend operations.
# SERVER-ONLY. NEVER expose to browser. NEVER use as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ── ADMIN INITIALIZATION ─────────────────────────────────────
# Permanent platform administrator credentials for RBAC initialization.
# SERVER-ONLY. Both have safe in-code fallbacks for local dev only.
ADMIN_EMAIL="admin@openlearner.ai"
ADMIN_PASSWORD="your-secure-admin-password-min-12-chars"

# ── APPLICATION URL ──────────────────────────────────────────
# Canonical public origin. Used for cookie security rules (Secure flag).
# Production example: https://olvyn.onrender.com or your custom domain.
# Local development: http://localhost:3000
NEXT_PUBLIC_APP_URL="https://your-app.onrender.com"

# ── SUPABASE (PUBLIC / CLIENT-SIDE) ─────────────────────────
# Public Supabase HTTPS endpoint. Safe to expose to browser.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Public anonymous key for client-side Supabase Auth session hydration.
# Safe to expose to browser (anon key only — not service role key).
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
