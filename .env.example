# Supabase PostgreSQL Database Connection
# Transaction Pooler (for Serverless / Application):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / Session connection (for Prisma CLI migrations):
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Session / JWT Secret (min 32 characters)
AUTH_SECRET="your-32-character-secret-key-here-12345"

# Google Gemini API key for Nova AI learning assistant
GEMINI_API_KEY="your-gemini-api-key"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloud Supabase Storage & SDK (Optional / Production)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Permanent Administrator Credentials (RBAC Security)
ADMIN_EMAIL="admin@openlearner.ai"
ADMIN_PASSWORD="your-secure-admin-password"
